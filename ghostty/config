# Combined active Ghostty settings from both source config locations.
keybind = shift+enter=text:\x1b\r
macos-option-as-alt = true
keybind = ctrl+cmd+left=unbind
keybind = ctrl+cmd+right=unbind
keybind = ctrl+cmd+up=unbind
keybind = ctrl+cmd+down=unbind
keybind = super+enter=ignore
shell-integration-features = ssh-terminfo,ssh-env
